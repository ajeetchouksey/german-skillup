# Copy to .env.local for local dev (gitignored). Both values are public by
# design (a Worker URL and an OAuth client id, not secrets) — the matching
# Google client *secret* only ever lives server-side, as a `wrangler secret`
# on the auth Worker, never here. Unset/empty is a valid, supported state:
# login is fully optional (see src/lib/auth.tsx's isAuthConfigured()) — the
# app works identically with these blank.

VITE_AUTH_WORKER_URL=https://api.hallo.aaryaai.dev
VITE_GOOGLE_CLIENT_ID=

# Used only by scripts/generate-illustration.mjs (a local Node script, never
# shipped to the client bundle — deliberately NOT VITE_-prefixed). CF_ACCOUNT_ID
# is the same non-secret account id already in deploy-cloudflare-pages.yml.
# CF_AI_API_TOKEN is a separate, narrowly-scoped token (Account.Workers AI:Edit
# only) — distinct from the Pages-deploy CLOUDFLARE_API_TOKEN GitHub secret.
CF_ACCOUNT_ID=e898ebfc013f074cde300a1ed1c16418
CF_AI_API_TOKEN=
