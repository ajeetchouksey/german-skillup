# Copy to .env.local for local dev (gitignored). Both values are public by
# design (a Worker URL and an OAuth client id, not secrets) — the matching
# Google client *secret* only ever lives server-side, as a `wrangler secret`
# on the auth Worker, never here. Unset/empty is a valid, supported state:
# login is fully optional (see src/lib/auth.tsx's isAuthConfigured()) — the
# app works identically with these blank.

VITE_AUTH_WORKER_URL=https://api.hallo.aaryaai.dev
VITE_GOOGLE_CLIENT_ID=
